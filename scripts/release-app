#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_NAME="DamnMacOSWidgets"
BUILD_DIR="$ROOT_DIR/.build"
APP_BUNDLE="$BUILD_DIR/package/$APP_NAME.app"
ZIP_PATH="$BUILD_DIR/package/$APP_NAME.zip"

"$ROOT_DIR/scripts/package-app"

rm -f "$ZIP_PATH"
ditto -c -k --sequesterRsrc --keepParent "$APP_BUNDLE" "$ZIP_PATH"

if [[ "${NOTARIZE_APP:-1}" == "1" ]]; then
    if [[ -n "${NOTARYTOOL_PROFILE:-}" ]]; then
        xcrun notarytool submit "$ZIP_PATH" --keychain-profile "$NOTARYTOOL_PROFILE" --wait
    elif [[ -n "${APPLE_ID:-}" && -n "${APPLE_ID_PASSWORD:-}" && -n "${APPLE_TEAM_ID:-}" ]]; then
        xcrun notarytool submit "$ZIP_PATH" \
            --apple-id "$APPLE_ID" \
            --password "$APPLE_ID_PASSWORD" \
            --team-id "$APPLE_TEAM_ID" \
            --wait
    else
        echo "Notarization skipped. Set NOTARYTOOL_PROFILE or APPLE_ID/APPLE_ID_PASSWORD/APPLE_TEAM_ID to enable it."
        echo "$ZIP_PATH"
        exit 0
    fi

    xcrun stapler staple "$APP_BUNDLE"
fi

echo "$ZIP_PATH"
